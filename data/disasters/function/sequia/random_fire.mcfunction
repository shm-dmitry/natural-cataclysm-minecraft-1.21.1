# disasters:sequia/random_fire
# 5 случайных точек с огнём.

# Точка 1
summon marker ~ ~ ~ {Tags:["sequia_fire_tmp"]}
spreadplayers ~ ~ 5 25 true @e[tag=sequia_fire_tmp,limit=1]
execute at @e[tag=sequia_fire_tmp,limit=1] run setblock ~ ~1 ~ fire
kill @e[tag=sequia_fire_tmp]

